{
  "manifest_version": 3,
  "name": "JEV Autofill",
  "version": "0.4.6",
  "description": "Fills job application fields from a local profile when you click the button.",
  "key": "",
  "permissions": [
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "JEV Autofill"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      }
    }
  },
  "minimum_chrome_version": "105"
}
